<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <CopyBuildOutputToPublishDirectory>false</CopyBuildOutputToPublishDirectory>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\*\*.csproj" Exclude="..\$(MSBuildProjectName)\$(MSBuildProjectName).csproj" />
    <Content Include="..\TrayGarden\bin\$(Configuration)\$(TargetFramework)\TrayGarden.runtimeconfig.json" Link="TrayGarden.runtimeconfig.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\TrayGarden\bin\$(Configuration)\$(TargetFramework)\TrayGarden.deps.json" Link="TrayGarden.deps.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
