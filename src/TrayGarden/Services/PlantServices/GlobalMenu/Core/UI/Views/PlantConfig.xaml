<UserControl x:Class="TrayGarden.Services.PlantServices.GlobalMenu.Core.UI.Views.PlantConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">
    <UserControl.Resources>
        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="4 0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="#444444" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderIconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="4 0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="3" Padding="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SinglePlant">

            <Border CornerRadius="2" BorderBrush="DarkOliveGreen" BorderThickness="2" Margin="5">
                <Grid Background="#eeeeee">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100px"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <ToggleButton Cursor="Hand" x:Name="ButtonContainerForCheckBox" IsChecked="{Binding Path=IsEnabled, Mode=TwoWay}">
                        <CheckBox x:Name="IsEnabledBox"  IsChecked="{Binding ElementName=ButtonContainerForCheckBox, Path=IsChecked}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <ToggleButton.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="border" CornerRadius="2" Background="LightGray" BorderThickness="0" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="true">
                                                    <Setter Property="Background" TargetName="border" Value="LightGreen"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Grid x:Name="PlantServicesGrid" Grid.Column="1" Margin="5" IsEnabled="{Binding ElementName=ButtonContainerForCheckBox, Path=IsChecked}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="20" Padding="30 0" VerticalAlignment="Center" Text="{Binding Path=Name}" />

                            <ToggleButton x:Name="ServicesToggle" Grid.Column="1"
                                          Content="🧰" ToolTip="Services"
                                          IsHitTestVisible="{Binding ElementName=ServicesPopup, Path=IsOpen, Converter={StaticResource BooleanNotConverter}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource HeaderIconToggle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=HasToggleServices}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="ServicesPopup" PlacementTarget="{Binding ElementName=ServicesToggle}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True"
                                   IsOpen="{Binding ElementName=ServicesToggle, Path=IsChecked, Mode=TwoWay}">
                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="8 6">
                                    <ItemsControl ItemsSource="{Binding Path=ToggleServices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Path=IsEnabled}" Margin="0 3" VerticalContentAlignment="Center"
                                                          FontSize="16" Cursor="Hand" Content="{Binding Path=ServiceName}"
                                                          ToolTip="{Binding Path=Description}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>

                            <Button Grid.Column="2" Content="🛠️" ToolTip="{Binding Path=SettingsService.Description}"
                                    Command="{Binding Path=SettingsService.PerformServiceAction}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=SettingsService}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" Foreground="#808080" Text="{Binding Path=Description}" />
                        <StackPanel Grid.Row="2" Grid.RowSpan="2">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HasRareCommands}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Separator />
                        <ItemsControl ItemsSource="{Binding Path=RareCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="30 2" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                            Content="{Binding Path=ServiceName}" ContentStringFormat="▶  {0}"
                                            ToolTip="{Binding Path=Description}"
                                            Command="{Binding Path=PerformServiceAction}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemTemplate="{StaticResource SinglePlant}" ItemsSource="{Binding Path=PlantVMs}" >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel ScrollViewer.CanContentScroll="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
