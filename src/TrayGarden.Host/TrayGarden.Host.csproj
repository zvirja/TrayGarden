<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\TrayGarden\Resources\gardenIconV5.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every sibling project is a plant (or the core); adding a plant project is enough to ship it. -->
    <ProjectReference Include="..\*\*.csproj" Exclude="..\$(MSBuildProjectName)\$(MSBuildProjectName).csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
