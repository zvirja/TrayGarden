{
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "TrayGarden": {
    "AppDataFolderName": "TrayGarden",
    "PlantsAutodetectFolder": "",
    "GlobalMenu": {
      "TrayIconResourceName": "gardenIconV2",
      "ContextMenu": {
        "BoldMainMenuEntries": false,
        "ItalicMainMenuEntries": false,
        "InsertDelimiterBetweenPlants": true,
        "ConfigureIconResourceName": "configureV1",
        "ExitIconResourceName": "exitIconV1"
      }
    },
    "NotifyIconChanger": {
      "DefaultDelayMsec": 500
    },
    "WindowWithBack": {
      "IconResourceKey": "gardenIconV3"
    },
    "RuntimeSettings": {
      "AutoSaveIntervalSeconds": 0,
      "Storage": {
        "FileName": "RuntimeSettings.xml",
        "UseLocalFolder": true,
        "EnableDebuggingTraces": false
      }
    },
    "Resources": {
      "Sources": [
        { "Assembly": "TrayGarden", "Path": "TrayGarden.Resources.GlobalResources" }
      ]
    }
  }
}
